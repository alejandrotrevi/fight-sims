# Entombed Sentinels (mythic) - measured fight profile for SimulationCraft / Raidbots
# Raidbots: Fight Style = Casting Patchwerk (NOT Patchwerk: it deletes raid events), Number of Bosses = 1,
#   then Custom APL and SimC Options > tick "SimC Expert Mode" > paste this into Script Footer.
# Measured from 30 mythic kills on Warcraft Logs, patch 12.1.5 (258-369 s kills).
# Kill length: median of 1000 ranked guild kills (each guild's best) = 338 s (10th pct 305, 90th 359). Set your own here:
max_time=338
vary_combat_length=0.05

# The boss
# The golems are tanked 40+ yd apart (99% damage reduction when closer) and each half of the raid hits its own: one target.
enemy=Breath_of_Ula_tek

# Adds: spawn = first hit on the wave, duration = first hit to last hit (median), count = median wave size
# Exposure (count x duration) calibrated x1.098: simc has no positions, so every area spell reaches every add.
# This makes the share of damage that goes into adds match real players of the same spec. Measured values: boss page.
# Venom Coagulation x1: 30/30 kills, spawn +-0.1s, alive 108.2s x 0.5 (only the Breath side can reach it and the groups swap sides every Stasis)
raid_events+=/adds,name=Venom_Coagulation_1,count=1,first=16.3,duration=59.4,cooldown=9999,health=1e10
# Venom Coagulation x1: 30/30 kills, spawn +-0.7s, alive 33.7s x 0.5 (only the Breath side can reach it and the groups swap sides every Stasis)
raid_events+=/adds,name=Venom_Coagulation_2,count=1,first=74.6,duration=18.4,cooldown=9999,health=1e10
# Venom Coagulation x1: 18/30 kills, spawn +-0.3s, alive 20s x 0.5 (only the Breath side can reach it and the groups swap sides every Stasis)
raid_events+=/adds,name=Venom_Coagulation_3,count=1,first=126.6,duration=11,cooldown=9999,health=1e10
# Venom Coagulation x1: 29/30 kills, spawn +-26s, alive 24.2s x 0.5 (only the Breath side can reach it and the groups swap sides every Stasis)
raid_events+=/adds,name=Venom_Coagulation_4,count=1,first=178.7,duration=13.3,cooldown=9999,health=1e10
# Venom Coagulation x1: 15/30 kills, spawn +-0.3s, alive 26.1s x 0.5 (only the Breath side can reach it and the groups swap sides every Stasis)
raid_events+=/adds,name=Venom_Coagulation_5,count=1,first=230.5,duration=14.3,cooldown=9999,health=1e10
# Venom Coagulation x1: 26/30 kills, spawn +-0.5s, alive 21.4s x 0.5 (only the Breath side can reach it and the groups swap sides every Stasis)
raid_events+=/adds,name=Venom_Coagulation_6,count=1,first=284.3,duration=11.7,cooldown=9999,health=1e10

# Boss out of reach: absent for a whole phase, or taking under 35% of its normal damage
# Breath of Ula'tek absent this phase (present 20% of it)
raid_events+=/invulnerable,name=Breath_of_Ula_tek_away_1,target=Breath_of_Ula_tek,first=46.3,duration=12,cooldown=9999
# Breath of Ula'tek absent this phase (present 16% of it)
raid_events+=/invulnerable,name=Breath_of_Ula_tek_away_2,target=Breath_of_Ula_tek,first=149.3,duration=13,cooldown=9999
# Breath of Ula'tek absent this phase (present 2% of it)
raid_events+=/invulnerable,name=Breath_of_Ula_tek_away_3,target=Breath_of_Ula_tek,first=253.3,duration=14.5,cooldown=9999


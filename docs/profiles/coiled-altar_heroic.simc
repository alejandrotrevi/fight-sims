# Ghastly Regeneration: 204.4-213.7 s, up to 95% of ranged
raid_events+=/movement,name=R_Ghastly_Regeneration_1,players_only=1,distance_min=6,first=205.2,duration=5.2,cooldown=9999
# Gloombomb: 274.3-278.1 s, up to 31% of ranged
raid_events+=/movement,name=R_Gloombomb_1,players_only=1,distance_min=6,first=275.9,duration=0.7,cooldown=9999
# Eternal Nightfall: 279.3-291.8 s, up to 39% of ranged
raid_events+=/movement,name=R_Eternal_Nightfall_2,players_only=1,distance_min=6,first=284.2,duration=2.1,cooldown=9999
# Blighted Sever: 307.1-329.1 s, up to 60% of ranged
raid_events+=/movement,name=R_Blighted_Sever_1,players_only=1,distance_min=6,first=315.1,duration=5.4,cooldown=9999
# Gloombomb: 330.6-338.6 s, up to 49% of ranged

# Damage taken windows, timed from the aura in the logs. simc ADDS the multiplier: 0.3 = +30%, 1 = +100%
# Venomous Heart exposed on Venomous Heart: +100% damage taken, 30/30 kills, start +-0s
raid_events+=/vulnerable,name=Venomous_Heart_exposed_1,target=Venomous_Heart,multiplier=1,first=145.5,duration=20,cooldown=9999
# Defect: Weakened on Weakened Doomscale: +100% damage taken, 30/30 kills, start +-2.5s
raid_events+=/vulnerable,name=Defect_Weakened_1,target=Weakened_Doomscale,multiplier=1,first=269.2,duration=44.4,cooldown=9999
# Venomous Heart exposed on Venomous Heart: +100% damage taken, 30/30 kills, start +-0s

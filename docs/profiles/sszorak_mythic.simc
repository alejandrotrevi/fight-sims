# Sszorak (mythic) - measured fight profile for SimulationCraft / Raidbots
# Raidbots: Fight Style = Casting Patchwerk (NOT Patchwerk: it deletes raid events), Number of Bosses = 1,
#   then Custom APL and SimC Options > tick "SimC Expert Mode" > paste this into Script Footer.
# Measured from 30 mythic kills on Warcraft Logs, patch 12.1.5 (277-378 s kills).
# Kill length: median of 1000 ranked guild kills (each guild's best) = 354 s (10th pct 318, 90th 374). Set your own here:
max_time=354
vary_combat_length=0.05

# The boss
enemy=Sszorak

# Damage taken windows, timed from the aura in the logs. simc ADDS the multiplier: 0.3 = +30%, 1 = +100%
# Dig In on Sszorak: +30% damage taken, 30/30 kills, start +-0s
raid_events+=/vulnerable,name=Dig_In_1,target=Sszorak,multiplier=0.3,first=100,duration=25,cooldown=9999
# Dig In on Sszorak: +30% damage taken, 30/30 kills, start +-0s
raid_events+=/vulnerable,name=Dig_In_2,target=Sszorak,multiplier=0.3,first=227,duration=25,cooldown=9999
# Dig In on Sszorak: +30% damage taken, 15/30 kills, start +-0s
raid_events+=/vulnerable,name=Dig_In_3,target=Sszorak,multiplier=0.3,first=354.1,duration=25,cooldown=9999

# Melee movement (distance_max=6: melee only): time out of melee range, from auto-attack gaps; 11.1 s in a 354 s kill
# Raging Crosswinds: 29.3-51.8 s, up to 17% of melee
raid_events+=/movement,name=M_Raging_Crosswinds_1,players_only=1,distance_max=6,first=40.3,duration=2.2,cooldown=9999
# Venomous Surge: 74.5-87 s, up to 17% of melee

# The Twin Fangs (mythic) - measured fight profile for SimulationCraft / Raidbots
# Raidbots: Fight Style = Casting Patchwerk (NOT Patchwerk: it deletes raid events), Number of Bosses = 1,
#   then Custom APL and SimC Options > tick "SimC Expert Mode" > paste this into Script Footer.
# Measured from 30 mythic kills on Warcraft Logs, patch 12.1.5 (324-467 s kills).
# Kill length: median of 945 ranked guild kills (each guild's best) = 394 s (10th pct 359, 90th 416). Set your own here:
max_time=394
vary_combat_length=0.05

# Bosses (all attackable at once unless an event below says otherwise)
enemy=Vexhul
enemy=Ithraz

# Adds: spawn = first hit on the wave, duration = first hit to last hit (median), count = median wave size
# Exposure (count x duration) calibrated x0.421: simc has no positions, so every area spell reaches every add.
# This makes the share of damage that goes into adds match real players of the same spec. Measured values: boss page.
# Spawn of Vexhul x1: 30/30 kills, spawn +-0.4s
raid_events+=/adds,name=Spawn_of_Vexhul_1,count=1,first=34.8,duration=14.7,cooldown=9999,health=1e10
# Broodling of Ithraz x4: 30/30 kills, spawn +-0.2s
raid_events+=/adds,name=Broodling_of_Ithraz_1,count=4,first=36.1,duration=4.3,cooldown=9999,health=1e10
# Spawn of Vexhul x1: 30/30 kills, spawn +-0.3s
raid_events+=/adds,name=Spawn_of_Vexhul_2,count=1,first=95.9,duration=13.8,cooldown=9999,health=1e10
# Broodling of Ithraz x4: 30/30 kills, spawn +-0.3s
raid_events+=/adds,name=Broodling_of_Ithraz_2,count=4,first=97.3,duration=4.5,cooldown=9999,health=1e10
# Spawn of Vexhul x1: 30/30 kills, spawn +-0.2s
raid_events+=/adds,name=Spawn_of_Vexhul_3,count=1,first=190.1,duration=13,cooldown=9999,health=1e10
# Broodling of Ithraz x4: 30/30 kills, spawn +-0.1s
raid_events+=/adds,name=Broodling_of_Ithraz_3,count=4,first=191.2,duration=4.6,cooldown=9999,health=1e10
# Spawn of Vexhul x1: 30/30 kills, spawn +-0.3s

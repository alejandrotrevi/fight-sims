# The Twin Fangs (heroic) - measured fight profile for SimulationCraft / Raidbots
# Raidbots: Fight Style = Casting Patchwerk (NOT Patchwerk: it deletes raid events), Number of Bosses = 1,
#   then Custom APL and SimC Options > tick "SimC Expert Mode" > paste this into Script Footer.
# Measured from 30 heroic kills on Warcraft Logs, patch 12.1.5 (246-494 s kills).
# Kill length: median of 116 heroic kills in randomly sampled public logs = 360 s (10th pct 280, 90th 444). Set your own here:
max_time=360
vary_combat_length=0.05

# Bosses (all attackable at once unless an event below says otherwise)
enemy=Vexhul
enemy=Ithraz

# Adds: spawn = first hit on the wave, duration = first hit to last hit (median), count = median wave size
# Exposure (count x duration) calibrated x1.03: simc has no positions, so every area spell reaches every add.
# This makes the share of damage that goes into adds match real players of the same spec. Measured values: boss page.
# Spawn of Vexhul x3: 30/30 kills, spawn +-0.3s
raid_events+=/adds,name=Spawn_of_Vexhul_1,count=3,first=38.8,duration=10.2,cooldown=9999,health=1e10
# Spawn of Vexhul x3: 30/30 kills, spawn +-0.7s
raid_events+=/adds,name=Spawn_of_Vexhul_2,count=3,first=106.7,duration=10.9,cooldown=9999,health=1e10
# Spawn of Vexhul x3: 30/30 kills, spawn +-0.4s
raid_events+=/adds,name=Spawn_of_Vexhul_3,count=3,first=208.3,duration=11.3,cooldown=9999,health=1e10
# Spawn of Vexhul x3: 27/30 kills, spawn +-0.4s
raid_events+=/adds,name=Spawn_of_Vexhul_4,count=3,first=276.2,duration=11.5,cooldown=9999,health=1e10

# Boss out of reach: absent for a whole phase, or taking under 35% of its normal damage
# Ithraz: 28/30 kills, damage falls to 11%
raid_events+=/invulnerable,name=Ithraz_away_1,target=Ithraz,first=150,duration=18.5,cooldown=9999
# Ithraz: 20/30 kills, damage falls to 10%
raid_events+=/invulnerable,name=Ithraz_away_2,target=Ithraz,first=318,duration=10.5,cooldown=9999

# Melee movement (distance_max=6: melee only): time out of melee range, from auto-attack gaps; 24.6 s in a 360 s kill
# Stir the Depths: 113.5-132.5 s, up to 23% of melee
raid_events+=/movement,name=M_Stir_the_Depths_1,players_only=1,distance_max=6,first=121.5,duration=2.7,cooldown=9999
# Sanguine Storm: 146-178.8 s, up to 81% of melee
raid_events+=/movement,name=M_Sanguine_Storm_1,players_only=1,distance_max=6,first=153.1,duration=8.5,cooldown=9999
# Stir the Depths: 209.5-233 s, up to 18% of melee
raid_events+=/movement,name=M_Stir_the_Depths_2,players_only=1,distance_max=6,first=220.4,duration=2,cooldown=9999
# Stir the Depths: 275.3-303.8 s, up to 22% of melee
raid_events+=/movement,name=M_Stir_the_Depths_3,players_only=1,distance_max=6,first=287.6,duration=2.9,cooldown=9999
# Sanguine Storm: 315.5-346.8 s, up to 82% of melee
raid_events+=/movement,name=M_Sanguine_Storm_2,players_only=1,distance_max=6,first=323.8,duration=8.5,cooldown=9999
# Venomous Emergence: 375.5-383.3 s, up to 21% of melee
raid_events+=/movement,name=M_Venomous_Emergence_1,players_only=1,distance_max=6,first=378.7,duration=1.1,cooldown=9999


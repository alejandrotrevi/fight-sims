# Blightscale Rawling x1: 23/30 kills, spawn +-1.7s
raid_events+=/adds,name=Blightscale_Rawling_9,count=1,first=512.7,duration=7.1,cooldown=9999,health=1e10

# Boss out of reach: absent for a whole phase, or taking under 35% of its normal damage
# Gore Rattle: 30/30 kills, damage falls to 0%
raid_events+=/invulnerable,name=Gore_Rattle_away_1,target=Gore_Rattle,first=0.1,duration=6,cooldown=9999
# Venomous Heart is only a target in its measured windows
raid_events+=/invulnerable,name=Venomous_Heart_away_1,target=Venomous_Heart,first=0.1,duration=135,cooldown=9999
# Weakened Doomscale is only a target in its measured windows
raid_events+=/invulnerable,name=Weakened_Doomscale_away_1,target=Weakened_Doomscale,first=0.1,duration=225.2,cooldown=9999
# Gore Rattle: 30/30 kills, damage falls to 2%
raid_events+=/invulnerable,name=Gore_Rattle_away_2,target=Gore_Rattle,first=60.5,duration=13,cooldown=9999
# Gore Rattle: 30/30 kills, damage falls to 0%
raid_events+=/invulnerable,name=Gore_Rattle_away_3,target=Gore_Rattle,first=133,duration=30,cooldown=9999
# Ula'tek: 30/30 kills, damage falls to 0%
raid_events+=/invulnerable,name=Ula_tek_away_1,target=Ula_tek,first=157,duration=7,cooldown=9999
# Venomous Heart is only a target in its measured windows
raid_events+=/invulnerable,name=Venomous_Heart_away_2,target=Venomous_Heart,first=158,duration=127,cooldown=9999
# Ula'tek absent this phase outside its measured window (present 22% of it)
raid_events+=/invulnerable,name=Ula_tek_away_2,target=Ula_tek,first=164.1,duration=111.9,cooldown=9999
# Gore Rattle absent this phase (present 0% of it)
raid_events+=/invulnerable,name=Gore_Rattle_away_4,target=Gore_Rattle,first=164.1,duration=144.9,cooldown=9999
# Weakened Doomscale is only a target in its measured windows
raid_events+=/invulnerable,name=Weakened_Doomscale_away_2,target=Weakened_Doomscale,first=264.7,duration=334.2,cooldown=9999
# Venomous Heart is only a target in its measured windows
raid_events+=/invulnerable,name=Venomous_Heart_away_3,target=Venomous_Heart,first=306,duration=292.9,cooldown=9999
# Ula'tek absent this phase (present 3% of it)
raid_events+=/invulnerable,name=Ula_tek_away_3,target=Ula_tek,first=309,duration=53.8,cooldown=9999
# Gore Rattle absent this phase (present 0% of it)
raid_events+=/invulnerable,name=Gore_Rattle_away_5,target=Gore_Rattle,first=309,duration=53.8,cooldown=9999
# Gore Rattle absent this phase (present 0% of it)
raid_events+=/invulnerable,name=Gore_Rattle_away_6,target=Gore_Rattle,first=362.8,duration=236.1,cooldown=9999
# Ula'tek: 21/30 kills, damage falls to 15%
raid_events+=/invulnerable,name=Ula_tek_away_4,target=Ula_tek,first=430.5,duration=6,cooldown=9999

# Damage taken windows, timed from the aura in the logs. simc ADDS the multiplier: 0.3 = +30%, 1 = +100%
# Venomous Heart exposed on Venomous Heart: +100% damage taken, 30/30 kills, start +-0s
raid_events+=/vulnerable,name=Venomous_Heart_exposed_1,target=Venomous_Heart,multiplier=1,first=135.5,duration=20,cooldown=9999
# Defect: Weakened on Weakened Doomscale: +100% damage taken, 30/30 kills, start +-3s
raid_events+=/vulnerable,name=Defect_Weakened_1,target=Weakened_Doomscale,multiplier=1,first=225.2,duration=39.5,cooldown=9999
# Venomous Heart exposed on Venomous Heart: +100% damage taken, 30/30 kills, start +-0s
raid_events+=/vulnerable,name=Venomous_Heart_exposed_2,target=Venomous_Heart,multiplier=1,first=284.5,duration=20,cooldown=9999


# Ula'tek (heroic) - measured fight profile for SimulationCraft / Raidbots
# Raidbots: Fight Style = Casting Patchwerk (NOT Patchwerk: it deletes raid events), Number of Bosses = 1,
#   then Custom APL and SimC Options > tick "SimC Expert Mode" > paste this into Script Footer.
# Measured from 30 heroic kills on Warcraft Logs, patch 12.1.5 (432-602 s kills).
# Kill length: median of 187 heroic kills in randomly sampled public logs = 565 s (10th pct 485, 90th 590). Set your own here:
max_time=565
vary_combat_length=0.05

# Bosses (all attackable at once unless an event below says otherwise)
enemy=Ula_tek
enemy=Gore_Rattle
enemy=Venomous_Heart
enemy=Weakened_Doomscale

# Adds: spawn = first hit on the wave, duration = first hit to last hit (median), count = median wave size
# Exposure (count x duration) calibrated x0.2: simc has no positions, so every area spell reaches every add.
# This makes the share of damage that goes into adds match real players of the same spec. Measured values: boss page.
# Blightscale Rawling x1: 30/30 kills, spawn +-0.3s
raid_events+=/adds,name=Blightscale_Rawling_1,count=1,first=27.6,duration=8.8,cooldown=9999,health=1e10
# Blightscale Rawling x2: 30/30 kills, spawn +-0.2s
raid_events+=/adds,name=Blightscale_Rawling_2,count=2,first=122.6,duration=15.1,cooldown=9999,health=1e10
# Doomscale Warden x1: 30/30 kills, spawn +-0.6s, 2 spawn x 0.5 (the raid splits in two for this phase)
raid_events+=/adds,name=Doomscale_Warden_1,count=1,first=167.7,duration=40.4,cooldown=9999,health=1e10
# Blightscale Clutch x3: 30/30 kills, spawn +-1s, 5 spawn x 0.5 (the raid splits in two for this phase)
raid_events+=/adds,name=Blightscale_Clutch_1,count=3,first=177.5,duration=7.1,cooldown=9999,health=1e10
# Blightscale Rawling x3: 30/30 kills, spawn +-1.6s, 5 spawn x 0.5 (the raid splits in two for this phase)
raid_events+=/adds,name=Blightscale_Rawling_3,count=3,first=184,duration=10.3,cooldown=9999,health=1e10
# Blightscale Rawling x5: 28/30 kills, spawn +-5.2s, 9 spawn x 0.5 (the raid splits in two for this phase)
raid_events+=/adds,name=Blightscale_Rawling_4,count=5,first=215.3,duration=12.3,cooldown=9999,health=1e10
# Blightscale Rawling x16: 30/30 kills, spawn +-0.2s
raid_events+=/adds,name=Blightscale_Rawling_5,count=16,first=326.9,duration=15.4,cooldown=9999,health=1e10
# Blightscale Clutch x1: 30/30 kills, spawn +-0.3s
raid_events+=/adds,name=Blightscale_Clutch_2,count=1,first=372.4,duration=6.8,cooldown=9999,health=1e10
# Blightscale Rawling x1: 30/30 kills, spawn +-1.4s
raid_events+=/adds,name=Blightscale_Rawling_6,count=1,first=377.9,duration=10.2,cooldown=9999,health=1e10
# Blightscale Clutch x1: 30/30 kills, spawn +-0.3s
raid_events+=/adds,name=Blightscale_Clutch_3,count=1,first=402.4,duration=7.9,cooldown=9999,health=1e10
# Blightscale Rawling x1: 30/30 kills, spawn +-1.8s
raid_events+=/adds,name=Blightscale_Rawling_7,count=1,first=409.4,duration=11.8,cooldown=9999,health=1e10
# Blightscale Clutch x1: 29/30 kills, spawn +-0.3s
raid_events+=/adds,name=Blightscale_Clutch_4,count=1,first=447.2,duration=4.3,cooldown=9999,health=1e10
# Blightscale Shrieker x1: 29/30 kills, spawn +-1.5s
raid_events+=/adds,name=Blightscale_Shrieker_1,count=1,first=450.9,duration=5.7,cooldown=9999,health=1e10
# Blightscale Rawling x1: 30/30 kills, spawn +-1.4s
raid_events+=/adds,name=Blightscale_Rawling_8,count=1,first=451.9,duration=9.1,cooldown=9999,health=1e10
# Blightscale Clutch x1: 24/30 kills, spawn +-0.3s
raid_events+=/adds,name=Blightscale_Clutch_5,count=1,first=507.4,duration=3.1,cooldown=9999,health=1e10
# Blightscale Shrieker x1: 23/30 kills, spawn +-1.1s

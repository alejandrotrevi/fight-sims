# Broodling of Ithraz x4: 28/30 kills, spawn +-0.3s
raid_events+=/adds,name=Broodling_of_Ithraz_5,count=4,first=346.2,duration=4.5,cooldown=9999,health=1e10

# Boss out of reach: absent for a whole phase, or taking under 35% of its normal damage
# Ithraz: 30/30 kills, damage falls to 10%
raid_events+=/invulnerable,name=Ithraz_away_1,target=Ithraz,first=135,duration=17,cooldown=9999
# Ithraz: 29/30 kills, damage falls to 8%
raid_events+=/invulnerable,name=Ithraz_away_2,target=Ithraz,first=290,duration=15,cooldown=9999


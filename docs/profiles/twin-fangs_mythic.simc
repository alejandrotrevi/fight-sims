# Broodling of Ithraz x4: 30/30 kills, spawn +-0.3s
raid_events+=/adds,name=Broodling_of_Ithraz_4,count=4,first=252.1,duration=4.8,cooldown=9999,health=1e10
# Spawn of Vexhul x1: 26/30 kills, spawn +-0.3s

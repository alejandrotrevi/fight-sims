# The Coiled Altar (mythic) - measured fight profile for SimulationCraft / Raidbots
# Raidbots: Fight Style = Casting Patchwerk (NOT Patchwerk: it deletes raid events), Number of Bosses = 1,
#   then Custom APL and SimC Options > tick "SimC Expert Mode" > paste this into Script Footer.
# Measured from 30 mythic kills on Warcraft Logs, patch 12.1.5 (466-651 s kills).
# Kill length: median of 513 ranked guild kills (each guild's best) = 609 s (10th pct 526, 90th 630). Set your own here:
max_time=609
vary_combat_length=0.05

# Bosses (all attackable at once unless an event below says otherwise)
enemy=Zul_jan
enemy=Hex_Lord_Malacrass

# Adds: spawn = first hit on the wave, duration = first hit to last hit (median), count = median wave size
# Exposure (count x duration) calibrated x0.2: simc has no positions, so every area spell reaches every add.
# This makes the share of damage that goes into adds match real players of the same spec. Measured values: boss page.
# Spiteful Soulcoiler x1: 30/30 kills, spawn +-0.3s
raid_events+=/adds,name=Spiteful_Soulcoiler_1,count=1,first=193.7,duration=9.6,cooldown=9999,health=1e10
# Spiteful Soulcoiler x1: 30/30 kills, spawn +-0.5s
raid_events+=/adds,name=Spiteful_Soulcoiler_2,count=1,first=226.9,duration=13.2,cooldown=9999,health=1e10
# Spiteful Soulcoiler x1: 30/30 kills, spawn +-0.4s
raid_events+=/adds,name=Spiteful_Soulcoiler_3,count=1,first=278.8,duration=10.1,cooldown=9999,health=1e10
# Spiteful Soulcoiler x1: 30/30 kills, spawn +-0.3s
raid_events+=/adds,name=Spiteful_Soulcoiler_4,count=1,first=312.2,duration=12.8,cooldown=9999,health=1e10
# Spiteful Soulcoiler x2: 21/30 kills, spawn +-0.3s
raid_events+=/adds,name=Spiteful_Soulcoiler_5,count=2,first=363.2,duration=20.6,cooldown=9999,health=1e10
# Spiteful Soulcoiler x1: 30/30 kills, spawn +-0.3s
raid_events+=/adds,name=Spiteful_Soulcoiler_6,count=1,first=493.3,duration=11.4,cooldown=9999,health=1e10
# Spiteful Soulcoiler x1: 28/30 kills, spawn +-0.5s
raid_events+=/adds,name=Spiteful_Soulcoiler_7,count=1,first=590.1,duration=8.7,cooldown=9999,health=1e10

# Boss out of reach: absent for a whole phase, or taking under 35% of its normal damage
# Hex Lord Malacrass absent this phase (present 0% of it)
raid_events+=/invulnerable,name=Hex_Lord_Malacrass_away_1,target=Hex_Lord_Malacrass,first=0.1,duration=167.6,cooldown=9999
# Zul'jan absent this phase (present 0% of it)
raid_events+=/invulnerable,name=Zul_jan_away_1,target=Zul_jan,first=167.6,duration=218.1,cooldown=9999
# Hex Lord Malacrass: 30/30 kills, damage falls to 0%
raid_events+=/invulnerable,name=Hex_Lord_Malacrass_away_2,target=Hex_Lord_Malacrass,first=168,duration=8,cooldown=9999
# Hex Lord Malacrass: 20/30 kills, damage falls to 13%
raid_events+=/invulnerable,name=Hex_Lord_Malacrass_away_3,target=Hex_Lord_Malacrass,first=359.4,duration=26,cooldown=9999
# Hex Lord Malacrass absent this phase (present 2% of it)
raid_events+=/invulnerable,name=Hex_Lord_Malacrass_away_4,target=Hex_Lord_Malacrass,first=385.7,duration=37.8,cooldown=9999

# Damage taken windows, timed from the aura in the logs. simc ADDS the multiplier: 0.3 = +30%, 1 = +100%
# Ghastly Regeneration on Zul'jan: +100% damage taken, 30/30 kills, start +-0.3s
raid_events+=/vulnerable,name=Ghastly_Regeneration_1,target=Zul_jan,multiplier=1,first=388.9,duration=34.8,cooldown=9999


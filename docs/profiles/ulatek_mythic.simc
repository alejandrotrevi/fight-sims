# Ula'tek (mythic) - measured fight profile for SimulationCraft / Raidbots
# Raidbots: Fight Style = Casting Patchwerk (NOT Patchwerk: it deletes raid events), Number of Bosses = 1,
#   then Custom APL and SimC Options > tick "SimC Expert Mode" > paste this into Script Footer.
# Measured from 30 mythic kills on Warcraft Logs, patch 12.1.5 (565-612 s kills).
# Kill length: median of 196 ranked guild kills (each guild's best) = 598 s (10th pct 591, 90th 603). Set your own here:
max_time=598
vary_combat_length=0.05

# Bosses (all attackable at once unless an event below says otherwise)
enemy=Ula_tek
enemy=Gore_Rattle
enemy=Venomous_Heart
enemy=Weakened_Doomscale

# Adds: spawn = first hit on the wave, duration = first hit to last hit (median), count = median wave size
# Exposure (count x duration) calibrated x0.373: simc has no positions, so every area spell reaches every add.
# This makes the share of damage that goes into adds match real players of the same spec. Measured values: boss page.
# Blightscale Wretch x1: 30/30 kills, spawn +-0.4s
raid_events+=/adds,name=Blightscale_Wretch_1,count=1,first=3.6,duration=30.5,cooldown=9999,health=1e10
# Blightscale Spawn x3: 30/30 kills, spawn +-0.2s
raid_events+=/adds,name=Blightscale_Spawn_1,count=3,first=10.5,duration=16.6,cooldown=9999,health=1e10
# Blightscale Rawling x3: 30/30 kills, spawn +-0.1s
raid_events+=/adds,name=Blightscale_Rawling_1,count=3,first=40.6,duration=18.2,cooldown=9999,health=1e10

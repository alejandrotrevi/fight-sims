# Vashnik the Malignant (mythic) - measured fight profile for SimulationCraft / Raidbots
# Raidbots: Fight Style = Casting Patchwerk (NOT Patchwerk: it deletes raid events), Number of Bosses = 1,
#   then Custom APL and SimC Options > tick "SimC Expert Mode" > paste this into Script Footer.
# Measured from 30 mythic kills on Warcraft Logs, patch 12.1.5 (261-370 s kills).
# Kill length: median of 1000 ranked guild kills (each guild's best) = 343 s (10th pct 301, 90th 364). Set your own here:
max_time=343
vary_combat_length=0.05

# The boss
enemy=Vashnik

# Adds: spawn = first hit on the wave, duration = first hit to last hit (median), count = median wave size
# Exposure (count x duration) calibrated x0.905: simc has no positions, so every area spell reaches every add.
# This makes the share of damage that goes into adds match real players of the same spec. Measured values: boss page.
# Shrouded Venom x7: 30/30 kills, spawn +-0s
raid_events+=/adds,name=Shrouded_Venom_1,count=7,first=24.1,duration=4.2,cooldown=9999,health=1e10
# Burning Venom x3: 30/30 kills, spawn +-1.5s
raid_events+=/adds,name=Burning_Venom_1,count=3,first=28.8,duration=13.3,cooldown=9999,health=1e10
# Shrouded Venom x7: 30/30 kills, spawn +-0s
raid_events+=/adds,name=Shrouded_Venom_2,count=7,first=108.1,duration=7.6,cooldown=9999,health=1e10
# Burning Venom x3: 30/30 kills, spawn +-28.9s
raid_events+=/adds,name=Burning_Venom_2,count=3,first=111.3,duration=16.6,cooldown=9999,health=1e10
# Shrouded Venom x7: 30/30 kills, spawn +-0s
raid_events+=/adds,name=Shrouded_Venom_3,count=7,first=192.1,duration=9.9,cooldown=9999,health=1e10
# Burning Venom x3: 30/30 kills, spawn +-41.4s
raid_events+=/adds,name=Burning_Venom_3,count=3,first=194.3,duration=18.7,cooldown=9999,health=1e10
# Burning Venom x1: 15/30 kills, spawn +-29.4s
raid_events+=/adds,name=Burning_Venom_4,count=1,first=209.5,duration=15.4,cooldown=9999,health=1e10
# Burning Venom x3: 29/30 kills, spawn +-42.8s
raid_events+=/adds,name=Burning_Venom_5,count=3,first=225.6,duration=22.4,cooldown=9999,health=1e10
# Shrouded Venom x7: 29/30 kills, spawn +-0s
raid_events+=/adds,name=Shrouded_Venom_4,count=7,first=276.1,duration=13.7,cooldown=9999,health=1e10


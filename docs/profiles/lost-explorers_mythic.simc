# The Lost Explorers (mythic) - measured fight profile for SimulationCraft / Raidbots
# Raidbots: Fight Style = Casting Patchwerk (NOT Patchwerk: it deletes raid events), Number of Bosses = 1,
#   then Custom APL and SimC Options > tick "SimC Expert Mode" > paste this into Script Footer.
# Measured from 30 mythic kills on Warcraft Logs, patch 12.1.5 (232-343 s kills).
# Kill length: median of 1000 ranked guild kills (each guild's best) = 317 s (10th pct 274, 90th 338). Set your own here:
max_time=317
vary_combat_length=0.05

# Bosses (all attackable at once unless an event below says otherwise)
# Two explorers are kept in cleave range; which ones changes between kills, so the names are placeholders.
enemy=Trader_Gebbo
enemy=First_Mate_Nama

# Melee movement (distance_max=6: melee only): time out of melee range, from auto-attack gaps; 14.6 s in a 317 s kill
# Frostfire Volley: 73-88.2 s, up to 29% of melee
raid_events+=/movement,name=M_Frostfire_Volley_1,players_only=1,distance_max=6,first=77.7,duration=2.5,cooldown=9999
# Shell Spin: 98.7-114 s, up to 38% of melee
raid_events+=/movement,name=M_Shell_Spin_1,players_only=1,distance_max=6,first=104.1,duration=3.3,cooldown=9999
# Blink Nova: 129.7-144.5 s, up to 19% of melee
raid_events+=/movement,name=M_Blink_Nova_1,players_only=1,distance_max=6,first=136.8,duration=1.3,cooldown=9999
# Shell Spin: 177.5-182.5 s, up to 16% of melee

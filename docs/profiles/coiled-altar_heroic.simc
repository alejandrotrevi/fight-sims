# The Coiled Altar (heroic) - measured fight profile for SimulationCraft / Raidbots
# Raidbots: Fight Style = Casting Patchwerk (NOT Patchwerk: it deletes raid events), Number of Bosses = 1,
#   then Custom APL and SimC Options > tick "SimC Expert Mode" > paste this into Script Footer.
# Measured from 30 heroic kills on Warcraft Logs, patch 12.1.5 (255-516 s kills).
# Kill length: median of 196 heroic kills in randomly sampled public logs = 381 s (10th pct 320, 90th 453). Set your own here:
max_time=381
vary_combat_length=0.05

# Bosses (all attackable at once unless an event below says otherwise)
enemy=Zul_jan
enemy=Hex_Lord_Malacrass

# Adds: spawn = first hit on the wave, duration = first hit to last hit (median), count = median wave size
# Exposure (count x duration) calibrated x0.721: simc has no positions, so every area spell reaches every add.
# This makes the share of damage that goes into adds match real players of the same spec. Measured values: boss page.
# Spiteful Soulcoiler x1: 30/30 kills, spawn +-0.4s
raid_events+=/adds,name=Spiteful_Soulcoiler_1,count=1,first=128.8,duration=9.2,cooldown=9999,health=1e10
# Spiteful Soulcoiler x1: 30/30 kills, spawn +-0.5s
raid_events+=/adds,name=Spiteful_Soulcoiler_2,count=1,first=162.4,duration=11,cooldown=9999,health=1e10

# Boss out of reach: absent for a whole phase, or taking under 35% of its normal damage
# Hex Lord Malacrass absent this phase (present 0% of it)
raid_events+=/invulnerable,name=Hex_Lord_Malacrass_away_1,target=Hex_Lord_Malacrass,first=0.1,duration=102.5,cooldown=9999
# Zul'jan absent this phase (present 2% of it)
raid_events+=/invulnerable,name=Zul_jan_away_1,target=Zul_jan,first=102.5,duration=101.9,cooldown=9999
# Hex Lord Malacrass: 30/30 kills, damage falls to 0%
raid_events+=/invulnerable,name=Hex_Lord_Malacrass_away_2,target=Hex_Lord_Malacrass,first=103.1,duration=8,cooldown=9999
# Hex Lord Malacrass absent this phase (present 5% of it)
raid_events+=/invulnerable,name=Hex_Lord_Malacrass_away_3,target=Hex_Lord_Malacrass,first=204.4,duration=37.9,cooldown=9999

# Damage taken windows, timed from the aura in the logs. simc ADDS the multiplier: 0.3 = +30%, 1 = +100%
# Ghastly Regeneration on Zul'jan: +100% damage taken, 30/30 kills, start +-0.4s
raid_events+=/vulnerable,name=Ghastly_Regeneration_1,target=Zul_jan,multiplier=1,first=207.7,duration=34.9,cooldown=9999

# Melee movement (distance_max=6: melee only): time out of melee range, from auto-attack gaps; 18.2 s in a 381 s kill
# Toxic Deluge: 4-19 s, up to 12% of melee
raid_events+=/movement,name=M_Toxic_Deluge_1,players_only=1,distance_max=6,first=10.2,duration=1,cooldown=9999
# Movement: 102.5-114.5 s, up to 100% of melee
raid_events+=/movement,name=M_Movement_1,players_only=1,distance_max=6,first=103,duration=9.6,cooldown=9999
# Spiritcackle: 155.8-161.8 s, up to 16% of melee
raid_events+=/movement,name=M_Spiritcackle_1,players_only=1,distance_max=6,first=157.9,duration=0.6,cooldown=9999
# Ghastly Regeneration: 204.4-224.9 s, up to 64% of melee
raid_events+=/movement,name=M_Ghastly_Regeneration_1,players_only=1,distance_max=6,first=207.5,duration=3.8,cooldown=9999
# Eternal Nightfall: 289.3-298.6 s, up to 14% of melee
raid_events+=/movement,name=M_Eternal_Nightfall_1,players_only=1,distance_max=6,first=292.9,duration=0.7,cooldown=9999
# Blighted Sever: 308.3-314.1 s, up to 14% of melee
raid_events+=/movement,name=M_Blighted_Sever_1,players_only=1,distance_max=6,first=310.4,duration=0.5,cooldown=9999
# Gloombomb: 316.8-343.1 s, up to 12% of melee
raid_events+=/movement,name=M_Gloombomb_1,players_only=1,distance_max=6,first=327.9,duration=2,cooldown=9999
# Eternal Nightfall: 389.1-397.1 s, up to 16% of melee
raid_events+=/movement,name=M_Eternal_Nightfall_2,players_only=1,distance_max=6,first=392.7,duration=0.8,cooldown=9999

# Ranged movement (distance_min=6: ranged only): time casters could not hard-cast, from cast gaps; 34.7 s in a 381 s kill
# Toxic Deluge: 43-51 s, up to 28% of ranged
raid_events+=/movement,name=R_Toxic_Deluge_1,players_only=1,distance_min=6,first=45.6,duration=1.4,cooldown=9999

# Entombed Sentinels (heroic) - measured fight profile for SimulationCraft / Raidbots
# Raidbots: Fight Style = Casting Patchwerk (NOT Patchwerk: it deletes raid events), Number of Bosses = 1,
#   then Custom APL and SimC Options > tick "SimC Expert Mode" > paste this into Script Footer.
# Measured from 30 heroic kills on Warcraft Logs, patch 12.1.5 (196-539 s kills).
# Kill length: median of 188 heroic kills in randomly sampled public logs = 304 s (10th pct 231, 90th 387). Set your own here:
max_time=304
vary_combat_length=0.05

# The boss
# The golems are tanked 40+ yd apart (99% damage reduction when closer) and each half of the raid hits its own: one target.
enemy=Breath_of_Ula_tek

# Adds: spawn = first hit on the wave, duration = first hit to last hit (median), count = median wave size
# Exposure (count x duration) calibrated x1.218: simc has no positions, so every area spell reaches every add.
# This makes the share of damage that goes into adds match real players of the same spec. Measured values: boss page.
# Venom Coagulation x1: 30/30 kills, spawn +-0.1s, alive 75.6s x 0.5 (only the Breath side can reach it and the groups swap sides every Stasis)
raid_events+=/adds,name=Venom_Coagulation_1,count=1,first=16.4,duration=46,cooldown=9999,health=1e10
# Venom Coagulation x1: 30/30 kills, spawn +-26.1s, alive 45.4s x 0.5 (only the Breath side can reach it and the groups swap sides every Stasis)
raid_events+=/adds,name=Venom_Coagulation_2,count=1,first=101.1,duration=27.6,cooldown=9999,health=1e10
# Venom Coagulation x1: 30/30 kills, spawn +-26s, alive 21s x 0.5 (only the Breath side can reach it and the groups swap sides every Stasis)
raid_events+=/adds,name=Venom_Coagulation_3,count=1,first=178,duration=12.8,cooldown=9999,health=1e10
# Venom Coagulation x1: 16/30 kills, spawn +-0.5s, alive 18s x 0.5 (only the Breath side can reach it and the groups swap sides every Stasis)
raid_events+=/adds,name=Venom_Coagulation_4,count=1,first=281.8,duration=11,cooldown=9999,health=1e10

# Boss out of reach: absent for a whole phase, or taking under 35% of its normal damage
# Breath of Ula'tek absent this phase (present 18% of it)
raid_events+=/invulnerable,name=Breath_of_Ula_tek_away_1,target=Breath_of_Ula_tek,first=46.4,duration=12,cooldown=9999
# Breath of Ula'tek absent this phase (present 18% of it)
raid_events+=/invulnerable,name=Breath_of_Ula_tek_away_2,target=Breath_of_Ula_tek,first=149.3,duration=12.1,cooldown=9999
# Breath of Ula'tek absent this phase (present 5% of it)
raid_events+=/invulnerable,name=Breath_of_Ula_tek_away_3,target=Breath_of_Ula_tek,first=253.4,duration=12,cooldown=9999

# Melee movement (distance_max=6: melee only): time out of melee range, from auto-attack gaps; 19.1 s in a 304 s kill
# Vitriolic Stasis: 43.3-47 s, up to 56% of melee
raid_events+=/movement,name=M_Vitriolic_Stasis_1,players_only=1,distance_max=6,first=45.6,duration=0.8,cooldown=9999

# Vashnik the Malignant (heroic) - measured fight profile for SimulationCraft / Raidbots
# Raidbots: Fight Style = Casting Patchwerk (NOT Patchwerk: it deletes raid events), Number of Bosses = 1,
#   then Custom APL and SimC Options > tick "SimC Expert Mode" > paste this into Script Footer.
# Measured from 30 heroic kills on Warcraft Logs, patch 12.1.5 (176-463 s kills).
# Kill length: median of 183 heroic kills in randomly sampled public logs = 266 s (10th pct 209, 90th 347). Set your own here:
max_time=266
vary_combat_length=0.05

# The boss
enemy=Vashnik

# Adds: spawn = first hit on the wave, duration = first hit to last hit (median), count = median wave size
# Exposure (count x duration) calibrated x0.873: simc has no positions, so every area spell reaches every add.
# This makes the share of damage that goes into adds match real players of the same spec. Measured values: boss page.
# Shrouded Venom x4: 30/30 kills, spawn +-0.2s
raid_events+=/adds,name=Shrouded_Venom_1,count=4,first=24.1,duration=6,cooldown=9999,health=1e10
# Burning Venom x2: 30/30 kills, spawn +-2.4s
raid_events+=/adds,name=Burning_Venom_1,count=2,first=28.6,duration=9.7,cooldown=9999,health=1e10
# Shrouded Venom x4: 30/30 kills, spawn +-0.1s
raid_events+=/adds,name=Shrouded_Venom_2,count=4,first=108.1,duration=8.9,cooldown=9999,health=1e10
# Burning Venom x2: 30/30 kills, spawn +-1.7s
raid_events+=/adds,name=Burning_Venom_2,count=2,first=112.3,duration=15.2,cooldown=9999,health=1e10
# Shrouded Venom x4: 29/30 kills, spawn +-0s
raid_events+=/adds,name=Shrouded_Venom_3,count=4,first=192.1,duration=10.6,cooldown=9999,health=1e10
# Burning Venom x2: 29/30 kills, spawn +-3.2s
raid_events+=/adds,name=Burning_Venom_3,count=2,first=197.4,duration=16.2,cooldown=9999,health=1e10

# Melee movement (distance_max=6: melee only): time out of melee range, from auto-attack gaps; 6.4 s in a 266 s kill
# Dripping Fangs: 26.3-45.8 s, up to 12% of melee
raid_events+=/movement,name=M_Dripping_Fangs_1,players_only=1,distance_max=6,first=35.5,duration=1.4,cooldown=9999
# Dripping Fangs: 120.8-136.8 s, up to 15% of melee
raid_events+=/movement,name=M_Dripping_Fangs_2,players_only=1,distance_max=6,first=126.9,duration=1.6,cooldown=9999
# Dripping Fangs: 193.3-227 s, up to 16% of melee
raid_events+=/movement,name=M_Dripping_Fangs_3,players_only=1,distance_max=6,first=207,duration=2.6,cooldown=9999
# Dripping Fangs: 257.8-266 s, up to 15% of melee
raid_events+=/movement,name=M_Dripping_Fangs_4,players_only=1,distance_max=6,first=261.3,duration=0.8,cooldown=9999

# Ranged movement (distance_min=6: ranged only): time casters could not hard-cast, from cast gaps; 17.7 s in a 266 s kill
# Dripping Fangs: 25.3-50 s, up to 33% of ranged

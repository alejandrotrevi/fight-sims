# Sszorak (heroic) - measured fight profile for SimulationCraft / Raidbots
# Raidbots: Fight Style = Casting Patchwerk (NOT Patchwerk: it deletes raid events), Number of Bosses = 1,
#   then Custom APL and SimC Options > tick "SimC Expert Mode" > paste this into Script Footer.
# Measured from 30 heroic kills on Warcraft Logs, patch 12.1.5 (186-422 s kills).
# Kill length: median of 136 heroic kills in randomly sampled public logs = 284 s (10th pct 227, 90th 356). Set your own here:
max_time=284
vary_combat_length=0.05

# The boss
enemy=Sszorak

# Damage taken windows, timed from the aura in the logs. simc ADDS the multiplier: 0.3 = +30%, 1 = +100%
# Dig In on Sszorak: +30% damage taken, 30/30 kills, start +-0s
raid_events+=/vulnerable,name=Dig_In_1,target=Sszorak,multiplier=0.3,first=111.1,duration=25,cooldown=9999
# Dig In on Sszorak: +30% damage taken, 23/30 kills, start +-0s
raid_events+=/vulnerable,name=Dig_In_2,target=Sszorak,multiplier=0.3,first=249.3,duration=25,cooldown=9999

# Melee movement (distance_max=6: melee only): time out of melee range, from auto-attack gaps; 5.1 s in a 284 s kill
# Raging Crosswinds: 47.5-58 s, up to 19% of melee
raid_events+=/movement,name=M_Raging_Crosswinds_1,players_only=1,distance_max=6,first=51.4,duration=1.1,cooldown=9999
# Raging Crosswinds: 98.3-107.8 s, up to 13% of melee
raid_events+=/movement,name=M_Raging_Crosswinds_2,players_only=1,distance_max=6,first=102.9,duration=0.8,cooldown=9999
# Movement: 130.6-136.4 s, up to 17% of melee
raid_events+=/movement,name=M_Movement_1,players_only=1,distance_max=6,first=132.7,duration=0.6,cooldown=9999
# Movement: 136.1-147.9 s, up to 14% of melee
raid_events+=/movement,name=M_Movement_2,players_only=1,distance_max=6,first=140.1,duration=1,cooldown=9999
# Raging Crosswinds: 184.1-194.1 s, up to 15% of melee
raid_events+=/movement,name=M_Raging_Crosswinds_3,players_only=1,distance_max=6,first=188.6,duration=0.9,cooldown=9999
# Movement: 268.6-273.6 s, up to 22% of melee
raid_events+=/movement,name=M_Movement_3,players_only=1,distance_max=6,first=270.2,duration=0.7,cooldown=9999

# Ranged movement (distance_min=6: ranged only): time casters could not hard-cast, from cast gaps; 38.8 s in a 284 s kill
# Raging Crosswinds: 35-57.8 s, up to 55% of ranged
raid_events+=/movement,name=R_Raging_Crosswinds_1,players_only=1,distance_min=6,first=43.7,duration=6.4,cooldown=9999

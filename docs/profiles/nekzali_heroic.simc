# Nek'zali the Soulcoiler (heroic) - measured fight profile for SimulationCraft / Raidbots
# Raidbots: Fight Style = Casting Patchwerk (NOT Patchwerk: it deletes raid events), Number of Bosses = 1,
#   then Custom APL and SimC Options > tick "SimC Expert Mode" > paste this into Script Footer.
# Measured from 30 heroic kills on Warcraft Logs, patch 12.1.5 (181-552 s kills).
# Kill length: median of 234 heroic kills in randomly sampled public logs = 283 s (10th pct 219, 90th 366). Set your own here:
max_time=283
vary_combat_length=0.05

# Bosses (all attackable at once unless an event below says otherwise)
enemy=Nek_zali_the_Soulcoiler
enemy=Echo_of_Jawae

# Adds: spawn = first hit on the wave, duration = first hit to last hit (median), count = median wave size
# Exposure (count x duration) calibrated x0.395: simc has no positions, so every area spell reaches every add.
# This makes the share of damage that goes into adds match real players of the same spec. Measured values: boss page.
# Restless Amani x2: 30/30 kills, spawn +-2.2s
raid_events+=/adds,name=Restless_Amani_1,count=2,first=57.6,duration=11.9,cooldown=9999,health=1e10
# Restless Amani x2: 17/30 kills, spawn +-1.4s
raid_events+=/adds,name=Restless_Amani_2,count=2,first=157.9,duration=16.4,cooldown=9999,health=1e10
# Restless Amani x2: 30/30 kills, spawn +-16.2s
raid_events+=/adds,name=Restless_Amani_3,count=2,first=226.9,duration=11.9,cooldown=9999,health=1e10
# Restless Amani x2: 24/30 kills, spawn +-19.1s
raid_events+=/adds,name=Restless_Amani_4,count=2,first=237.9,duration=14.6,cooldown=9999,health=1e10
# Restless Amani x2: 15/30 kills, spawn +-1.5s
raid_events+=/adds,name=Restless_Amani_5,count=2,first=274.9,duration=10.9,cooldown=9999,health=1e10

# Boss out of reach: absent for a whole phase, or taking under 35% of its normal damage
# Echo of Jawae absent this phase (present 4% of it)
raid_events+=/invulnerable,name=Echo_of_Jawae_away_1,target=Echo_of_Jawae,first=0.1,duration=117.3,cooldown=9999
# Nek'zali the Soulcoiler: 30/30 kills, damage falls to 4%
raid_events+=/invulnerable,name=Nek_zali_the_Soulcoiler_away_1,target=Nek_zali_the_Soulcoiler,first=111.4,duration=6,cooldown=9999
# Nek'zali the Soulcoiler absent this phase (present 0% of it)
raid_events+=/invulnerable,name=Nek_zali_the_Soulcoiler_away_2,target=Nek_zali_the_Soulcoiler,first=117.3,duration=72.4,cooldown=9999
# Echo of Jawae absent this phase (present 2% of it)
raid_events+=/invulnerable,name=Echo_of_Jawae_away_2,target=Echo_of_Jawae,first=189.7,duration=110.3,cooldown=9999

# Melee movement (distance_max=6: melee only): time out of melee range, from auto-attack gaps; 22.4 s in a 283 s kill
# Ritual Burn: 59-103 s, up to 19% of melee
raid_events+=/movement,name=M_Ritual_Burn_1,players_only=1,distance_max=6,first=74.8,duration=4,cooldown=9999
# Movement: 108.3-117.3 s, up to 75% of melee
raid_events+=/movement,name=M_Movement_1,players_only=1,distance_max=6,first=111,duration=4.3,cooldown=9999
# Movement: 117.3-124.1 s, up to 38% of melee
raid_events+=/movement,name=M_Movement_2,players_only=1,distance_max=6,first=119.4,duration=1.9,cooldown=9999
# Movement: 134.3-168.8 s, up to 31% of melee
raid_events+=/movement,name=M_Movement_3,players_only=1,distance_max=6,first=149.3,duration=6.1,cooldown=9999
# Movement: 189.7-204.2 s, up to 55% of melee
raid_events+=/movement,name=M_Movement_4,players_only=1,distance_max=6,first=192.8,duration=3.2,cooldown=9999
# Invoke: 241.9-260.9 s, up to 13% of melee
raid_events+=/movement,name=M_Invoke_1,players_only=1,distance_max=6,first=250.2,duration=1.5,cooldown=9999
# Movement: 273.1-285.9 s, up to 22% of melee
raid_events+=/movement,name=M_Movement_5,players_only=1,distance_max=6,first=279.1,duration=1.4,cooldown=9999

